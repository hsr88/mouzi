---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import DownloadCards from '../../components/DownloadCards.astro';
import { translatedLocales, localizedPath, type Locale } from '../../i18n';
import { aboutCopy } from '../../i18n/about';
import { corePageCopy } from '../../i18n/core-pages';
import { projectPageCopy } from '../../i18n/project-pages';
import { localizedSigningMessage } from '../../i18n/download';
import { site } from '../../config/site';
import { roadmap, type RoadmapStatus } from '../../config/roadmap';
import { getRepoStats, formatCount } from '../../lib/github';
import { communityReach, independentCoverage } from '../../config/community';

const pages = ['features','download','faq','about','roadmap','privacy','support','sponsors','impact','changelog'] as const;
export function getStaticPaths() {
  const staticPages = ['features','download','faq','about','roadmap','privacy','support','sponsors','impact','changelog'] as const;
  return translatedLocales.flatMap((lang) => staticPages.map((page) => ({ params: { lang, page }, props: { lang, page } })));
}
const { lang, page } = Astro.props as { lang: Exclude<Locale, 'en'>; page: (typeof pages)[number] };
const c = corePageCopy[lang];
const p = projectPageCopy[lang];
const about = aboutCopy[lang];
const signingMessage = () => localizedSigningMessage(lang);
const local = (path: string) => localizedPath(path, lang);
const featureHrefs = ['/features/automatic-organization','/features/custom-rules','/docs/history-and-undo','/features/privacy'];
const featureImgs = ['/screenshots/automatic-organization.png','/screenshots/custom-rules.png','/screenshots/history-undo.png','/screenshots/privacy-security-settings.png'];
const sections: RoadmapStatus[] = ['now','next','later','shipped'];
const title = page === 'about' ? about.title : page in c ? c[page as keyof typeof c].title : p[page as keyof typeof p].title;
const description = page === 'about' ? about.title : page in c ? c[page as keyof typeof c].description : p[page as keyof typeof p].lead;
const stats = await getRepoStats();
const metricLabels={es:['Estrellas de GitHub','Forks','Colaboradores','Descargas','Idiomas','Plataformas'],pl:['Gwiazdki GitHub','Forki','Współtwórcy','Pobrania','Języki','Platformy'],de:['GitHub-Sterne','Forks','Mitwirkende','Downloads','Sprachen','Plattformen'],fr:['Étoiles GitHub','Forks','Contributeurs','Téléchargements','Langues','Plateformes'],it:['Stelle GitHub','Fork','Contributori','Download','Lingue','Piattaforme']}[lang];
const numberCards = metricLabels.map((label,i)=>[label,[formatCount(stats.stars),formatCount(stats.forks),formatCount(stats.contributors),site.metrics.verifiedDownloads?.label ?? '—',String(site.metrics.supportedLanguages),String(site.metrics.supportedPlatforms)][i]]);
const tierText={es:[['Socio técnico','Infraestructura, firma, software o servicios aportados al proyecto.'],['Patrocinador fundador','Logo y enlace en Sponsors y README.'],['Patrocinador principal','Espacio exclusivo en cabecera, presencia destacada y descripción breve.']],pl:[['Partner techniczny','Infrastruktura, podpis, oprogramowanie lub usługi dla projektu.'],['Sponsor założycielski','Logo i link na stronie sponsorów i w README.'],['Sponsor główny','Wyłączne miejsce w nagłówku, wyróżnienie i krótki opis.']],de:[['Technischer Partner','Infrastruktur, Signierung, Software oder Dienste für das Projekt.'],['Gründungssponsor','Logo und Link auf Sponsorenseite und im README.'],['Hauptsponsor','Exklusiver Header, prominente Platzierung und Kurzbeschreibung.']],fr:[['Partenaire technique','Infrastructure, signature, logiciel ou services fournis au projet.'],['Sponsor fondateur','Logo et lien sur la page Sponsors et le README.'],['Sponsor principal','En-tête exclusif, présence forte et courte description.']],it:[['Partner tecnico','Infrastruttura, firma, software o servizi per il progetto.'],['Sponsor fondatore','Logo e link nella pagina Sponsor e nel README.'],['Sponsor principale','Spazio esclusivo in testata, rilievo e breve descrizione.']]}[lang];
---
<BaseLayout title={`${title} — Mouzi`} description={description} canonical={`/${lang}/${page}`}>
  {page === 'features' && <div class="mx-auto max-w-6xl px-5 py-16">
    <SectionHeading kicker={c.features.kicker} title={c.features.title} lead={c.features.lead}/>
    <div class="mt-12 grid gap-5 sm:grid-cols-2">{c.features.cards.map((card,i) => <a href={featureHrefs[i].startsWith('/docs') ? featureHrefs[i] : local(featureHrefs[i])} class="group overflow-hidden rounded-card border border-line bg-surface"><img src={featureImgs[i]} alt={card.alt} width="968" height="700" class="aspect-[4/3] w-full border-b border-line object-cover"/><div class="p-5"><h2 class="text-lg font-semibold">{card.title}</h2><p class="mt-1.5 text-sm leading-relaxed text-muted">{card.body}</p></div></a>)}</div>
    <section class="mt-16"><p class="font-mono text-[11px] tracking-[.2em] text-amber uppercase">{c.features.demoKicker}</p><h2 class="mt-3 text-2xl font-semibold">{c.features.demoTitle}</h2><p class="mt-3 max-w-2xl text-muted">{c.features.demoBody}</p><video class="mt-8 w-full rounded-card border border-line" autoplay muted loop playsinline controls poster="/videos/mouzi-organizing-poster.webp"><source src="/videos/mouzi-organizing.webm" type="video/webm"/><source src="/videos/mouzi-organizing.mp4" type="video/mp4"/></video></section>
    <h2 class="mt-14 text-2xl font-semibold">{c.features.more}</h2><dl class="mt-8 grid gap-x-10 gap-y-6 sm:grid-cols-2 lg:grid-cols-3">{c.features.details.map((d) => <div class="border-t border-line pt-4"><dt class="font-medium">{d[0]}</dt><dd class="mt-1 text-sm text-muted">{d[1]}</dd></div>)}</dl>
    <div class="mt-16 flex gap-3"><a href={local('/download')} class="rounded-btn bg-amber px-6 py-3 font-semibold text-[#151004]">{c.download.title}</a><a href="/docs" class="rounded-btn border border-line px-6 py-3">{c.features.docs}</a></div>
  </div>}
  {page === 'download' && <div class="mx-auto max-w-6xl px-5 py-16"><SectionHeading kicker={`${site.version} · ${site.releaseDate}`} title={c.download.title} lead={c.download.lead}/><p class="mt-4 font-mono text-xs text-muted">{signingMessage()}</p><div class="mt-12 grid gap-12 lg:grid-cols-2"><section><h2 class="mb-4 text-lg font-semibold">Windows <span class="font-mono text-xs text-muted">10 & 11 · x64</span></h2><DownloadCards platform="windows"/><a href={local('/download/windows')} class="mt-4 inline-block text-sm text-amber">{c.download.windowsGuide} →</a></section><section><h2 class="mb-4 text-lg font-semibold">Linux <span class="font-mono text-xs text-muted">x86_64</span></h2><DownloadCards platform="linux"/><a href={local('/download/linux')} class="mt-4 inline-block text-sm text-amber">{c.download.linuxGuide} →</a></section></div><div class="mt-16 rounded-card border border-line bg-surface p-6"><h2 class="font-semibold">{c.download.verifyTitle}</h2><p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted">{c.download.verifyBody} <a href={site.github.releases} class="text-amber">GitHub Releases</a> · <a href="/docs/security" class="text-amber">Security</a></p></div></div>}
  {page === 'faq' && <div class="mx-auto max-w-3xl px-5 py-16"><SectionHeading kicker={c.faq.kicker} title={c.faq.title}/><div class="mt-10 divide-y divide-line border-y border-line">{c.faq.items.map((f) => <details class="py-5"><summary class="cursor-pointer font-medium">{f[0]}</summary><p class="mt-3 text-muted">{f[1]}</p></details>)}</div><p class="mt-8 text-sm text-muted">{c.faq.missing} <a href={site.github.newIssue} class="text-amber">GitHub</a> · <a href="/docs" class="text-amber">Docs</a></p></div>}
  {page === 'about' && <div class="mx-auto max-w-3xl px-5 py-16"><SectionHeading kicker={about.kicker} title={about.title}/><div class="prose mt-10">{about.intro.map((p) => <p>{p}</p>)}<h2>{about.principles}</h2><ul>{about.items.map(([name,body]) => <li><strong>{name}.</strong> {body}</li>)}</ul><h2>{about.stackTitle}</h2><p>{about.stack}</p><h2>{about.contactTitle}</h2><p>{about.contact} <a href={site.github.issues}>GitHub Issues</a> · <a href={site.maintainer.x}>X</a> · <a href={site.maintainer.reddit}>r/Mouzi</a> · <a href={`mailto:${site.funding.contactEmail}`}>{site.funding.contactEmail}</a></p></div><div class="mt-12 flex gap-3"><a href={local('/impact')} class="rounded-btn border border-line px-5 py-2.5">{about.impact}</a><a href={local('/sponsors')} class="rounded-btn border border-line px-5 py-2.5">{about.sponsor}</a></div></div>}
  {page === 'roadmap' && <div class="mx-auto max-w-4xl px-5 py-16"><SectionHeading kicker={c.roadmap.kicker} title={c.roadmap.title} lead={c.roadmap.lead}/><div class="mt-12 space-y-14">{sections.map((status) => <section><div class="flex items-baseline gap-3"><h2 class="font-mono text-sm tracking-[.18em] text-amber uppercase">{c.roadmap.sections[status][0]}</h2><p class="text-sm text-muted">{c.roadmap.sections[status][1]}</p></div><ul class="mt-5 space-y-3">{roadmap.map((item,i) => ({item,i})).filter(({item}) => item.status === status).map(({item,i}) => <li class="rounded-card border border-line bg-surface p-5"><div class="flex flex-wrap items-center gap-3"><h3 class="font-semibold">{c.roadmap.items[i][0]}</h3>{item.target && <span class="font-mono text-xs text-muted">{item.target}</span>}{item.issue && <a href={item.issue} class="ml-auto font-mono text-xs text-muted">#{item.issue.split('/').pop()}</a>}</div><p class="mt-1.5 text-sm text-muted">{c.roadmap.items[i][1]}</p></li>)}</ul></section>)}</div><p class="mt-14 border-t border-line pt-6 text-sm text-muted">{c.roadmap.missing} <a href={site.github.newIssue} class="text-amber">GitHub</a>.</p></div>}
  {page === 'privacy' && <div class="mx-auto max-w-3xl px-5 py-16"><SectionHeading kicker="Legal" title={p.privacy.title} lead={p.privacy.lead}/><section class="prose mt-10">{p.privacy.sections.map(([h,b])=><><h2>{h}</h2><p>{b}</p></>)}<p><button type="button" data-manage-analytics class="text-amber underline">{p.privacy.manage}</button></p><p><a href={`mailto:${site.funding.contactEmail}`}>{site.funding.contactEmail}</a></p></section></div>}
  {page === 'support' && <div class="mx-auto max-w-4xl px-5 py-16"><SectionHeading kicker="Help" title={p.support.title} lead={p.support.lead}/><div class="mt-12 grid gap-5 sm:grid-cols-2">{p.support.cards.map(([h,b,label],i)=>{const href=['/docs','/docs/troubleshooting',site.github.newIssue,`${site.github.url}/security/advisories/new`,site.maintainer.reddit,`mailto:${site.funding.contactEmail}`][i];return <div class="flex flex-col rounded-card border border-line bg-surface p-5"><h2 class="font-semibold">{h}</h2><p class="mt-2 flex-1 text-sm text-muted">{b}</p><a href={href} class="mt-4 text-sm text-amber">{label} →</a></div>})}</div></div>}
  {page === 'sponsors' && <div class="mx-auto max-w-4xl px-5 py-16"><SectionHeading kicker="Mouzi" title={p.sponsors.title} lead={p.sponsors.lead}/><section class="prose mt-12">{p.sponsors.sections.map(([h,b])=><><h2>{h}</h2><p>{b}</p></>)}</section><h2 class="mt-14 text-xl font-semibold">{p.sponsors.tiers}</h2><div class="mt-6 grid gap-5 md:grid-cols-3">{site.sponsorTiers.map((t,i)=><div class="rounded-card border border-line bg-surface p-5"><h3 class="font-semibold">{tierText[i][0]}</h3><p class="mt-1 font-mono text-sm text-amber">{t.price??'In kind'}</p><p class="mt-3 text-sm text-muted">{tierText[i][1]}</p></div>)}</div><h2 class="mt-14 text-xl font-semibold">{p.sponsors.partners}</h2><div class="mt-5 rounded-card border border-line bg-surface p-5"><strong>SignPath Foundation</strong><p class="mt-2 text-sm text-muted">Open-source code signing · Mouzi</p></div><h2 class="mt-14 text-xl font-semibold">{p.sponsors.placements}</h2><div class="mt-5 rounded-card border border-dashed border-line p-8 text-center">Header · Sponsors · GitHub README</div><div class="mt-12 flex flex-wrap gap-3"><a href={site.funding.githubSponsors} class="rounded-btn bg-amber px-5 py-2.5 text-[#151004]">{p.sponsors.buttons[0]}</a><a href={site.funding.kofi} class="rounded-btn border border-line px-5 py-2.5">{p.sponsors.buttons[1]}</a><a href={`mailto:${site.funding.contactEmail}`} class="rounded-btn border border-line px-5 py-2.5">{p.sponsors.buttons[2]}</a></div></div>}
  {page === 'impact' && <div class="mx-auto max-w-6xl px-5 py-16"><SectionHeading kicker="Mouzi" title={p.impact.title} lead={p.impact.lead}/><h2 class="mt-14 text-xl font-semibold">{p.impact.mission[0]}</h2><p class="mt-3 max-w-2xl text-muted">{p.impact.mission[1]}</p><h2 class="mt-12 text-xl font-semibold">{p.impact.numbers}</h2><dl class="mt-5 grid grid-cols-2 gap-4 sm:grid-cols-3">{numberCards.map(([label,value])=><div class="rounded-card border border-line bg-surface p-4"><dd class="font-mono text-2xl">{value}</dd><dt class="mt-1 text-sm text-muted">{label}</dt></div>)}</dl><h2 class="mt-14 text-xl font-semibold">{p.impact.reach[0]}</h2><p class="mt-3 max-w-2xl text-muted">{p.impact.reach[1]}</p><ul class="mt-5 grid gap-3 sm:grid-cols-2">{communityReach.filter(x=>x.enabled).map(x=><li class="rounded-card border border-line bg-surface p-4"><a href={x.url} class="font-medium text-amber">{'title' in x?x.title:'podcastName' in x?x.podcastName:'Community'}</a></li>)}</ul><h3 class="mt-8 font-semibold">Independent coverage</h3><ul class="mt-3 space-y-2">{independentCoverage.map(x=><li><a href={x.url} class="text-amber">{x.outlet}: {x.title}</a></li>)}</ul>{[p.impact.demand,p.impact.security,p.impact.costs].map(([h,b])=><><h2 class="mt-12 text-xl font-semibold">{h}</h2><p class="mt-3 max-w-2xl text-muted">{b}</p></>)}<ul class="mt-4 list-disc pl-5 text-muted">{p.impact.funding.map(x=><li>{x}</li>)}</ul><div class="mt-12 flex flex-wrap gap-3"><a href={site.github.url} class="rounded-btn border border-line px-5 py-2.5">{p.impact.buttons[0]}</a><a href="/blog" class="rounded-btn border border-line px-5 py-2.5">{p.impact.buttons[1]}</a><a href={`mailto:${site.funding.contactEmail}`} class="rounded-btn bg-amber px-5 py-2.5 text-[#151004]">{p.impact.buttons[2]}</a></div></div>}
  {page === 'changelog' && <div class="mx-auto max-w-3xl px-5 py-16"><SectionHeading kicker="Releases" title={p.changelog.title} lead={p.changelog.lead}/><div class="mt-12 space-y-12">{Object.entries(p.changelog.entries).map(([version,e])=><article class="border-l border-line pl-7"><h2 class="font-mono text-lg">v{version}</h2><h3 class="mt-1 text-xl font-semibold">{e.title}</h3><ul class="mt-4 list-disc pl-5 text-muted">{e.items.map(i=><li>{i}</li>)}</ul></article>)}</div><p class="mt-12 border-t border-line pt-6 text-sm text-muted">{p.changelog.older}: <a href={site.github.releases} class="text-amber">GitHub Releases</a></p></div>}
</BaseLayout>

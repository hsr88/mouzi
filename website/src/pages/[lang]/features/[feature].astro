---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import RuleDemo from '../../../components/RuleDemo.astro';
import PrivacyDiagram from '../../../components/PrivacyDiagram.astro';
import { translatedLocales, localizedPath, type Locale } from '../../../i18n';
import { corePageCopy } from '../../../i18n/core-pages';
import { localizedSigningMessage } from '../../../i18n/download';
import { site } from '../../../config/site';

const featureSlugs = ['automatic-organization','custom-rules','privacy','security'] as const;
export function getStaticPaths() {
  const slugs = ['automatic-organization','custom-rules','privacy','security'] as const;
  return translatedLocales.flatMap((lang) => slugs.map((feature) => ({params:{lang,feature},props:{lang,feature}})));
}
const {lang,feature} = Astro.props as {lang:Exclude<Locale,'en'>;feature:typeof featureSlugs[number]};
const signingMessage = () => localizedSigningMessage(lang);
const local=(p:string)=>localizedPath(p,lang);
const featureIndex = feature === 'automatic-organization' ? 0 : feature === 'custom-rules' ? 1 : feature === 'privacy' ? 3 : 3;
const names = corePageCopy[lang].features.cards;
const text = {
 es:{automaticOrganization:{title:'Organización automática',lead:'Mouzi vigila las carpetas elegidas y mueve archivos nuevos según tus reglas cuando es seguro hacerlo.',sections:[['Cómo funciona la vigilancia','Mouzi registra un observador del sistema de archivos. Tras un breve periodo de gracia comprueba que el archivo no esté bloqueado y evalúa las reglas de arriba abajo. La primera coincidencia decide el destino; si ninguna coincide, el archivo no se mueve.'],['Tres modos','Silencioso organiza continuamente. Manual espera a que pulses Organizar ahora. Pausado detiene la vigilancia. También puedes programar hasta cuatro ejecuciones de organización diarias.'],['Seguro con descargas activas','En modo silencioso espera el periodo de gracia, omite .crdownload, .part, .download y .tmp, ignora archivos vacíos y comprueba bloqueos. Las ejecuciones manuales y programadas no esperan.'],['Historial y deshacer','Cada movimiento correcto se guarda en SQLite local. Historial muestra archivo, destino y regla, y permite deshacer mientras el archivo siga allí.']]},customRules:{title:'Reglas personalizadas',lead:'Una regla es una condición y un destino. Las sencillas tardan segundos; las precisas pueden usar expresiones regulares.',sections:[['Coincidencias a tu manera','Usa extensiones, nombres o regex: desde PDF a Documentos hasta capturas o facturas con un patrón concreto.'],['Destinos que se crean solos','{year}, {month}, {day}, {extension} y {filename} crean rutas dinámicas. Las relativas viven en la carpeta vigilada y las absolutas pueden apuntar a otra unidad.'],['Prioridad y controles rápidos','Las reglas se ejecutan en orden y gana la primera coincidencia. Cada fila permite activar o pausar una regla sin borrarla.'],['Exclusiones','Un archivo .mouziignore admite comodines y comentarios para mantener archivos y subcarpetas fuera del alcance de Mouzi.']]},privacy:{title:'Tus archivos nunca salen de tu ordenador.',lead:'Un organizador ve todo lo que descargas. Mouzi está diseñado para que eso ocurra únicamente en tu equipo.',sections:[['Sin servidor','Evaluación, movimientos e historial suceden localmente. No existe infraestructura que pueda recibir tus datos.'],['Qué se guarda y dónde','Reglas y ajustes viven en la configuración local y el historial en SQLite: %APPDATA%\\Mouzi en Windows y ~/.config/mouzi en Linux. Borrar la carpeta elimina todo.'],['Actividad de red','Solo existe una comprobación opcional del feed público de GitHub. Nunca se transmiten nombres, rutas, contenido ni uso.'],['Abierto a inspección','Todo el código está en GitHub con licencia MIT. Un comportamiento contrario a esta página debe comunicarse mediante un aviso privado.']]},security:{title:'Versiones que puedes verificar.',lead:'La confianza no debería depender de la palabra del desarrollador. El código, los flujos de compilación y los archivos etiquetados son públicos.',sections:[['Compilación pública','GitHub Actions compila las versiones desde commits etiquetados y los pasos están en el repositorio.'],['SignPath Foundation',signingMessage()+' Cuando el certificado esté activo, CI enviará los archivos bajo una política restringida y comprobará sus firmas Authenticode.'],['Archivos directos de GitHub','Los botones de mouzi.cc apuntan al lanzamiento oficial, no a un espejo separado.'],['Verificación local','Puedes revisar una firma cuando exista y calcular SHA-256. Un hash solo verifica el archivo si se compara con un valor de confianza.'],['Por qué importa','Mouzi vigila Descargas, donde llegan archivos antes de abrirlos. Por eso la ruta pública de publicación merece ser inspeccionable.'],['Informar vulnerabilidades','Utiliza avisos de seguridad privados de GitHub, no Issues públicas.']] }},
 pl:{automaticOrganization:{title:'Automatyczna organizacja',lead:'Mouzi obserwuje wybrane foldery i przenosi nowe pliki zgodnie z regułami, gdy można to zrobić bezpiecznie.',sections:[['Jak działa obserwowanie','Mouzi rejestruje obserwator systemu plików. Po okresie ochronnym sprawdza blokadę i ocenia reguły od góry. Pierwsze dopasowanie wybiera cel; bez dopasowania plik zostaje na miejscu.'],['Trzy tryby','Cichy działa stale, ręczny czeka na „Organizuj teraz”, a wstrzymany wyłącza obserwowanie. Można też ustawić do czterech porządkowań dziennie.'],['Bezpieczeństwo aktywnych pobrań','Tryb cichy czeka, pomija .crdownload, .part, .download i .tmp, ignoruje puste pliki i sprawdza blokady. Tryb ręczny i harmonogram nie czekają.'],['Historia i cofanie','Udane ruchy trafiają do lokalnej bazy SQLite. Historia pokazuje plik, cel i regułę oraz pozwala cofnąć ruch, jeśli plik nadal istnieje.']]},customRules:{title:'Własne reguły',lead:'Reguła to warunek i miejsce docelowe. Proste tworzy się w kilka sekund, a precyzyjne mogą używać regex.',sections:[['Dopasowanie po Twojemu','Użyj rozszerzenia, nazwy lub regex: od plików PDF po zrzuty i faktury o konkretnym wzorcu.'],['Cele tworzące się same','{year}, {month}, {day}, {extension} i {filename} budują dynamiczne ścieżki. Względne są w obserwowanym folderze, bezwzględne mogą wskazywać inny dysk.'],['Priorytet i szybkie przełączniki','Reguły działają kolejno i wygrywa pierwsze dopasowanie. Każdą można wstrzymać bez usuwania.'],['Wykluczenia','.mouziignore obsługuje symbole wieloznaczne i komentarze, wyłączając wskazane pliki oraz foldery.']]},privacy:{title:'Twoje pliki nigdy nie opuszczają komputera.',lead:'Organizer widzi wszystko, co pobierasz. Mouzi robi to wyłącznie lokalnie.',sections:[['Brak serwera','Ocena reguł, przenoszenie i historia działają lokalnie. Nie istnieje infrastruktura mogąca odebrać dane.'],['Co i gdzie jest zapisane','Reguły i ustawienia są lokalne, historia jest w SQLite: %APPDATA%\\Mouzi w Windows i ~/.config/mouzi w Linuksie. Usunięcie folderu kasuje wszystko.'],['Ruch sieciowy','Jedynie opcjonalne sprawdzenie publicznych wydań GitHub. Nazwy, ścieżki, zawartość i dane użycia nie są wysyłane.'],['Kod do wglądu','Pełny kod jest na GitHubie na licencji MIT. Sprzeczne zachowanie należy zgłosić prywatnie jako błąd bezpieczeństwa.']]},security:{title:'Wydania, które możesz zweryfikować.',lead:'Zaufanie nie powinno opierać się na słowie autora. Kod, workflow i oznaczone pliki są publiczne.',sections:[['Publiczny build','GitHub Actions buduje wydania z oznaczonych commitów, a kroki znajdują się w repozytorium.'],['SignPath Foundation',signingMessage()+' Po aktywacji certyfikatu CI wyśle pliki w ramach ograniczonej polityki i sprawdzi Authenticode.'],['Bezpośrednie pliki GitHub','Przyciski mouzi.cc prowadzą do oficjalnego wydania, nie osobnego mirrora.'],['Lokalna weryfikacja','Można sprawdzić podpis i obliczyć SHA-256. Skrót wymaga zaufanej wartości porównawczej.'],['Dlaczego to ważne','Mouzi obserwuje Pobrane, gdzie trafiają pliki przed uruchomieniem, więc ścieżka wydania musi być przejrzysta.'],['Zgłaszanie luk','Użyj prywatnych GitHub Security Advisories, nie publicznych Issues.']] }},
 de:null,fr:null,it:null
} as any;
// The same full section structure is shared by every locale; German, French and Italian copy is supplied below.
const translated = {
 de:{automaticOrganization:['Automatische Organisation','Mouzi überwacht gewählte Ordner und verschiebt neue Dateien nach deinen Regeln, sobald es sicher ist.'],customRules:['Eigene Regeln','Eine Regel besteht aus Bedingung und Ziel. Einfache Regeln dauern Sekunden, präzise nutzen Regex.'],privacy:['Deine Dateien verlassen den Computer nie.','Mouzi verarbeitet Downloads ausschließlich auf deinem Gerät.'],security:['Versionen, die du überprüfen kannst.','Code, Build-Workflows und markierte Dateien sind öffentlich.']},
 fr:{automaticOrganization:['Organisation automatique','Mouzi surveille les dossiers choisis et déplace les nouveaux fichiers selon vos règles dès que cela est sûr.'],customRules:['Règles personnalisées','Une règle associe une condition à une destination ; les plus précises utilisent des expressions régulières.'],privacy:['Vos fichiers ne quittent jamais votre ordinateur.','Mouzi traite vos téléchargements uniquement sur votre appareil.'],security:['Des versions que vous pouvez vérifier.','Le code, les workflows et les fichiers balisés sont publics.']},
 it:{automaticOrganization:['Organizzazione automatica','Mouzi controlla le cartelle scelte e sposta i nuovi file secondo le regole quando è sicuro.'],customRules:['Regole personalizzate','Una regola unisce condizione e destinazione; quelle più precise usano regex.'],privacy:['I tuoi file non lasciano mai il computer.','Mouzi elabora i download esclusivamente sul dispositivo.'],security:['Versioni verificabili.','Codice, workflow e file con tag sono pubblici.']}
} as const;
if (!text[lang]) {
 const [title,lead]=translated[lang][feature === 'automatic-organization' ? 'automaticOrganization' : feature === 'custom-rules' ? 'customRules' : feature];
 const headings = lang==='de' ? ['Funktionsweise','Modi und Prioritäten','Sicherheit und lokale Daten','Weitere Einzelheiten'] : lang==='fr' ? ['Fonctionnement','Modes et priorités','Sécurité et données locales','Pour aller plus loin'] : ['Come funziona','Modalità e priorità','Sicurezza e dati locali','Altri dettagli'];
 const bodies = lang==='de' ? ['Mouzi beobachtet Dateisystemereignisse, wartet die Schutzfrist ab und wendet Regeln von oben nach unten an. Die erste Übereinstimmung gewinnt.','Leiser, manueller und pausierter Modus sowie bis zu vier geplante Läufe geben dir die Kontrolle. Regeln lassen sich einzeln schalten.','Temporäre Downloads, leere und gesperrte Dateien werden übersprungen. Regeln und Verlauf liegen lokal in SQLite.','Dynamische Pfade, .mouziignore und öffentliche Release-Workflows decken die vollständige Funktion ab.'] : lang==='fr' ? ['Mouzi observe le système de fichiers, attend le délai de sécurité puis applique les règles de haut en bas. La première correspondance gagne.','Modes silencieux, manuel et pause, jusqu’à quatre horaires quotidiens et activation individuelle des règles.','Les téléchargements temporaires, fichiers vides et verrouillés sont ignorés. Règles et historique restent dans SQLite local.','Chemins dynamiques, .mouziignore et workflows publics complètent le fonctionnement.'] : ['Mouzi osserva il file system, attende il periodo di sicurezza e applica le regole dall’alto. Vince la prima corrispondenza.','Modalità silenziosa, manuale e pausa, fino a quattro orari e attivazione individuale delle regole.','Download temporanei, file vuoti e bloccati vengono ignorati. Regole e cronologia restano in SQLite locale.','Percorsi dinamici, .mouziignore e workflow pubblici completano il funzionamento.'];
 text[lang]={ [feature === 'automatic-organization'?'automaticOrganization':feature === 'custom-rules'?'customRules':feature]:{title,lead,sections:headings.map((h,i)=>[h,bodies[i]])} };
}
const key=feature==='automatic-organization'?'automaticOrganization':feature==='custom-rules'?'customRules':feature;
const page=text[lang][key];
const image=feature==='automatic-organization'?'/screenshots/automatic-organization.png':feature==='custom-rules'?'/screenshots/custom-rules.png':feature==='privacy'?'/screenshots/privacy-security-settings.png':null;
---
<BaseLayout title={`${page.title} — Mouzi`} description={page.lead} canonical={`/${lang}/features/${feature}`}><div class="mx-auto max-w-4xl px-5 py-16"><SectionHeading kicker={corePageCopy[lang].features.kicker} title={page.title} lead={page.lead}/>{image&&<img src={image} alt={names[featureIndex].alt} width="968" height="700" class="mt-10 w-full rounded-card border border-line"/>}{feature==='custom-rules'&&<div class="mt-10"><RuleDemo/></div>}{feature==='privacy'&&<div class="mt-12"><PrivacyDiagram/></div>}<section class="prose mt-12">{page.sections.map(([h,b])=><><h2>{h}</h2><p>{b}</p></>)}</section><div class="mt-12 flex flex-wrap gap-3"><a href={local('/download')} class="rounded-btn bg-amber px-5 py-2.5 text-sm font-semibold text-[#151004]">{corePageCopy[lang].download.title}</a><a href="/docs" class="rounded-btn border border-line px-5 py-2.5 text-sm">Docs</a>{feature==='security'&&<a href={`${site.github.url}/security/advisories/new`} class="rounded-btn border border-line px-5 py-2.5 text-sm">GitHub Security</a>}</div></div></BaseLayout>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import DownloadCards from '../../../components/DownloadCards.astro';
import { translatedLocales, type Locale } from '../../../i18n';
import { corePageCopy } from '../../../i18n/core-pages';
import { localizedSigningMessage } from '../../../i18n/download';
import { site } from '../../../config/site';

export function getStaticPaths(){const platforms=['windows','linux'] as const;return translatedLocales.flatMap(lang=>platforms.map(platform=>({params:{lang,platform},props:{lang,platform}})));}
const {lang,platform}=Astro.props as {lang:Exclude<Locale,'en'>;platform:'windows'|'linux'};
const signingMessage = () => localizedSigningMessage(lang);
const labels={
 es:{leadW:'Tres versiones, una aplicación. El instalador sirve para la mayoría; MSI para despliegues; portable funciona sin instalación ni registro.',leadL:'AppImage funciona sin instalación. DEB y RPM se integran con el gestor de paquetes.',w:[['Instalación','Ejecuta el instalador y sigue los pasos. Mouzi arranca después, se añade a la bandeja y vigila Descargas. Nada se mueve hasta que existan reglas.'],['Aviso SmartScreen',signingMessage()+' Mientras tanto Windows puede mostrar “Windows protegió su PC”. Comprueba que el nombre coincide con la versión oficial antes de elegir Más información y Ejecutar de todas formas.'],['Versión portátil','Guarda la configuración junto al ejecutable, ideal para USB, equipos restringidos y pruebas. Para quitarla, borra el archivo.'],['Requisitos','Windows 10 u 11 de 64 bits; unos 20 MB; la versión portátil no requiere permisos de administrador.'],['Siguientes pasos','Consulta la guía de Windows o la documentación de reglas.']],l:[['AppImage','Da permiso con chmod +x y ejecuta el archivo. No requiere instalación ni root; AppImageLauncher puede añadirlo al menú y al inicio.'],['DEB (Debian, Ubuntu, Mint)','Instala con: sudo apt install ./Mouzi_'+site.version+'_amd64.deb'],['RPM (Fedora, openSUSE)','Instala con: sudo dnf install ./Mouzi-'+site.version+'-1.x86_64.rpm'],['Icono de bandeja','Mouzi vive en la bandeja. GNOME necesita la extensión AppIndicator; la documentación explica Wayland.'],['Siguientes pasos','Sigue la guía inicial para vigilar una carpeta y crear una regla; solución de problemas cubre los casos comunes.']]},
 pl:{leadW:'Trzy wydania, jedna aplikacja. Instalator dla większości osób, MSI do wdrożeń, portable bez instalacji i zmian rejestru.',leadL:'AppImage działa bez instalacji. DEB i RPM integrują się z menedżerem pakietów.',w:[['Instalacja','Uruchom instalator i przejdź przez kroki. Mouzi wystartuje, trafi do zasobnika i zacznie obserwować Pobrane. Bez reguł nic nie zostanie przeniesione.'],['Ostrzeżenie SmartScreen',signingMessage()+' Windows może pokazać komunikat ochrony. Sprawdź nazwę pliku i oficjalne źródło przed wybraniem Więcej informacji i Uruchom mimo to.'],['Wersja portable','Przechowuje konfigurację obok pliku, więc nadaje się na USB, zablokowane komputery i testy. Aby usunąć, skasuj plik.'],['Wymagania','Windows 10 lub 11 64-bit, około 20 MB; portable nie wymaga administratora.'],['Następne kroki','Przeczytaj przewodnik Windows albo dokumentację reguł.']],l:[['AppImage','Nadaj uprawnienie chmod +x i uruchom plik. Bez instalacji i roota; AppImageLauncher może dodać menu i autostart.'],['DEB (Debian, Ubuntu, Mint)','Polecenie: sudo apt install ./Mouzi_'+site.version+'_amd64.deb'],['RPM (Fedora, openSUSE)','Polecenie: sudo dnf install ./Mouzi-'+site.version+'-1.x86_64.rpm'],['Ikona zasobnika','Mouzi działa w zasobniku. GNOME wymaga rozszerzenia AppIndicator; dokumentacja opisuje Wayland.'],['Następne kroki','Przewodnik startowy opisuje pierwszy folder i regułę, a rozwiązywanie problemów typowe przypadki.']]},
 de:{leadW:'Drei Varianten, eine App: Installer für die meisten, MSI für Verwaltung, portable ohne Installation und Registry.',leadL:'AppImage läuft ohne Installation. DEB und RPM integrieren sich in die Paketverwaltung.',w:[['Installation','Installer starten und Schritten folgen. Mouzi startet, erscheint im Tray und überwacht Downloads. Ohne Regeln wird nichts verschoben.'],['SmartScreen',signingMessage()+' Windows kann warnen. Dateiname und offizielle Quelle prüfen, bevor „Weitere Informationen“ und „Trotzdem ausführen“ gewählt werden.'],['Portable Version','Konfiguration liegt neben der Datei; ideal für USB, gesperrte Rechner und Tests. Zum Entfernen Datei löschen.'],['Anforderungen','Windows 10/11 64-Bit, etwa 20 MB; portable ohne Administrator.'],['Nächste Schritte','Windows-Leitfaden oder Regeldokumentation lesen.']],l:[['AppImage','Mit chmod +x ausführbar machen und starten. Keine Installation oder root; AppImageLauncher kann Menü und Autostart integrieren.'],['DEB','sudo apt install ./Mouzi_'+site.version+'_amd64.deb'],['RPM','sudo dnf install ./Mouzi-'+site.version+'-1.x86_64.rpm'],['Tray-Symbol','Mouzi lebt im Tray. GNOME benötigt AppIndicator; Wayland-Hinweise stehen in der Dokumentation.'],['Nächste Schritte','Einstiegs- und Fehlerbehebungsleitfaden verwenden.']]},
 fr:{leadW:'Trois versions, une application : installateur courant, MSI pour le déploiement et portable sans installation.',leadL:'AppImage fonctionne sans installation. DEB et RPM utilisent votre gestionnaire de paquets.',w:[['Installation','Lancez l’installateur. Mouzi démarre, rejoint la zone de notification et surveille Téléchargements. Rien ne bouge sans règle.'],['SmartScreen',signingMessage()+' Windows peut avertir. Vérifiez le nom et la source officielle avant Plus d’informations puis Exécuter quand même.'],['Version portable','La configuration reste près du fichier, idéale pour USB et tests. Pour supprimer, effacez le fichier.'],['Configuration requise','Windows 10/11 64 bits, environ 20 Mo ; aucun droit administrateur pour portable.'],['Étapes suivantes','Consultez le guide Windows ou les règles.']],l:[['AppImage','Rendez le fichier exécutable avec chmod +x puis lancez-le. Ni installation ni root ; AppImageLauncher peut l’intégrer.'],['DEB','sudo apt install ./Mouzi_'+site.version+'_amd64.deb'],['RPM','sudo dnf install ./Mouzi-'+site.version+'-1.x86_64.rpm'],['Icône de notification','Mouzi reste dans la zone de notification. GNOME exige AppIndicator ; la documentation couvre Wayland.'],['Étapes suivantes','Suivez le démarrage rapide et le dépannage.']]},
 it:{leadW:'Tre build, una app: installer per la maggioranza, MSI per distribuzioni e portable senza installazione.',leadL:'AppImage funziona senza installazione. DEB e RPM si integrano col gestore pacchetti.',w:[['Installazione','Avvia l’installer. Mouzi parte, entra nella barra e controlla Download. Senza regole non sposta nulla.'],['SmartScreen',signingMessage()+' Windows può avvisare. Controlla nome e fonte ufficiale prima di Altre informazioni e Esegui comunque.'],['Versione portable','Configurazione accanto al file, adatta a USB e test. Per rimuoverla, elimina il file.'],['Requisiti','Windows 10/11 64 bit, circa 20 MB; portable senza amministratore.'],['Passi successivi','Consulta la guida Windows o le regole.']],l:[['AppImage','Usa chmod +x e avvia. Nessuna installazione o root; AppImageLauncher può integrarlo.'],['DEB','sudo apt install ./Mouzi_'+site.version+'_amd64.deb'],['RPM','sudo dnf install ./Mouzi-'+site.version+'-1.x86_64.rpm'],['Icona nella barra','Mouzi vive nella barra. GNOME richiede AppIndicator; la documentazione tratta Wayland.'],['Passi successivi','Segui la guida iniziale e la risoluzione problemi.']]}
}[lang];
const title=platform==='windows'?'Mouzi for Windows':'Mouzi for Linux';const sections=platform==='windows'?labels.w:labels.l;const lead=platform==='windows'?labels.leadW:labels.leadL;
---
<BaseLayout title={`${title} — Mouzi`} description={lead} canonical={`/${lang}/download/${platform}`}><div class="mx-auto max-w-4xl px-5 py-16"><SectionHeading kicker={`${site.version} · ${platform==='windows'?'Windows 10 & 11 · x64':'x86_64'}`} title={title} lead={lead}/><div class="mt-10"><DownloadCards platform={platform}/></div><section class="prose mt-14">{sections.map(([h,b])=><><h2>{h}</h2><p>{b}</p></>)}</section><div class="mt-12"><a href="/docs" class="rounded-btn border border-line px-5 py-2.5">Docs</a></div></div></BaseLayout>

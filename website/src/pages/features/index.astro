---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';

const featurePages = [
  {
    href: '/features/automatic-organization',
    title: 'Automatic organization',
    body: 'Watch folders, apply rules, move files. Silent, manual or scheduled.',
    img: '/screenshots/automatic-organization.png',
    alt: 'Mouzi settings showing watched folders in Silent, Manual and Paused modes',
    width: 968,
    height: 698,
  },
  {
    href: '/features/custom-rules',
    title: 'Custom rules',
    body: 'Extensions, name patterns, regex, dynamic paths and priorities.',
    img: '/screenshots/custom-rules.png',
    alt: 'Mouzi rules view listing rules for common file types',
    width: 952,
    height: 700,
  },
  {
    href: '/docs/history-and-undo',
    title: 'History and one-click undo',
    body: 'Review recent moves and restore a file when a rule sends it somewhere unexpected.',
    img: '/screenshots/history-undo.png',
    alt: 'Mouzi recent actions with destination folders and undo buttons',
    width: 964,
    height: 706,
  },
  {
    href: '/features/privacy',
    title: 'Privacy and security, by design',
    body: 'No cloud, no account, no telemetry. Local safeguards control when files are safe to move.',
    img: '/screenshots/privacy-security-settings.png',
    alt: 'Mouzi general settings with grace period and file lock controls',
    width: 956,
    height: 700,
  },
];

const details = [
  ['History and one-click undo', 'Successful moves are recorded locally and can be undone from History.'],
  ['Download-safe detection', 'Grace periods, lock checks and browser temp-file skips.'],
  ['Multiple watched folders', 'Each folder gets its own rules and behavior.'],
  ['Dynamic paths', 'Placeholders like {year} and {month} build dated folder trees.'],
  ['.mouziignore exclusions', 'Wildcards, folder patterns and inline comments.'],
  ['Scheduled organization', 'Up to four automatic runs per day, or fully manual mode.'],
  ['Google Takeout import', 'Unpack and sort Takeout archives in one step.'],
  ['10 languages', 'English, Polish, German, French, Spanish, Italian and more.'],
  ['Small tray application', 'Built with Rust and Tauri to run quietly in the background.'],
];
---

<BaseLayout
  title="Features — Mouzi, automatic Downloads folder organizer"
  description="What Mouzi does: automatic Downloads folder organization, custom rules with regex and dynamic paths, local-only history with undo, and verifiable releases."
  canonical="/features"
>
  <div class="mx-auto max-w-6xl px-5 py-16">
    <SectionHeading
      kicker="Features"
      title="Everything Mouzi does."
      lead="A tray app with one job: keep the folders you choose organized, on your terms, without your data going anywhere."
    />

    <div class="mt-12 grid gap-5 sm:grid-cols-2">
      {
        featurePages.map((f) => (
          <a href={f.href} class="group overflow-hidden rounded-card border border-line bg-surface transition-colors hover:border-amber/40">
            <img src={f.img} alt={f.alt} width={f.width} height={f.height} loading="lazy" class="aspect-[4/3] w-full border-b border-line object-cover" />
            <div class="p-5">
              <h2 class="text-lg font-semibold tracking-tight transition-colors group-hover:text-amber">{f.title}</h2>
              <p class="mt-1.5 text-sm leading-relaxed text-muted">{f.body}</p>
            </div>
          </a>
        ))
      }
    </div>

    <section class="mt-16">
      <div class="max-w-2xl">
        <p class="font-mono text-[11px] tracking-[0.2em] text-amber uppercase">See it work</p>
        <h2 class="mt-3 text-2xl font-semibold tracking-tight">A Downloads folder, organized in seconds.</h2>
        <p class="mt-3 leading-relaxed text-muted">
          This short recording shows Mouzi applying its rules and moving a mixed group of files into their destination folders on Linux.
        </p>
      </div>
      <video
        class="mt-8 w-full rounded-card border border-line bg-surface"
        width="1152"
        height="720"
        autoplay
        muted
        loop
        playsinline
        controls
        preload="metadata"
        poster="/videos/mouzi-organizing-poster.webp"
        aria-label="Mouzi organizing files into destination folders on Linux"
      >
        <source src="/videos/mouzi-organizing.webm" type="video/webm" />
        <source src="/videos/mouzi-organizing.mp4" type="video/mp4" />
      </video>
    </section>

    <div class="tdivider mt-16"></div>

    <h2 class="mt-14 text-2xl font-semibold tracking-tight">And the rest</h2>
    <dl class="mt-8 grid gap-x-10 gap-y-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        details.map(([title, body]) => (
          <div class="border-t border-line pt-4">
            <dt class="text-[15px] font-medium">{title}</dt>
            <dd class="mt-1 text-sm text-muted">{body}</dd>
          </div>
        ))
      }
    </dl>

    <div class="mt-16 flex flex-wrap gap-3">
      <a href="/download" class="rounded-btn bg-amber px-6 py-3 text-[15px] font-semibold text-[#151004] hover:opacity-90">Download Mouzi</a>
      <a href="/docs" class="rounded-btn border border-line px-6 py-3 text-[15px] text-cream hover:bg-surface-2">Read the docs</a>
    </div>
  </div>
</BaseLayout>

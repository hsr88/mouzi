---
import { localeFromPath, localizedPath } from '../i18n';
const measurementId = 'G-GMDTSE5DFS';
const locale=localeFromPath(Astro.url.pathname);
const a={en:['Optional analytics cookies','The Mouzi app sends no telemetry. With your consent, this website loads Google Analytics and sends page, device and approximate location data to Google.','Privacy details','Allow analytics','No thanks'],es:['Cookies de análisis opcionales','La aplicación no envía telemetría. Con tu consentimiento, este sitio carga Google Analytics y envía a Google datos de página, dispositivo y ubicación aproximada.','Detalles de privacidad','Permitir análisis','No, gracias'],pl:['Opcjonalne cookies analityczne','Aplikacja Mouzi nie wysyła telemetrii. Za Twoją zgodą strona uruchomi Google Analytics i wyśle Google dane strony, urządzenia i przybliżonej lokalizacji.','Szczegóły prywatności','Zezwól na analitykę','Nie, dziękuję'],de:['Optionale Analyse-Cookies','Die Mouzi-App sendet keine Telemetrie. Mit Zustimmung lädt diese Website Google Analytics und sendet Seiten-, Geräte- und ungefähre Standortdaten an Google.','Datenschutzdetails','Analyse erlauben','Nein, danke'],fr:['Cookies d’analyse facultatifs','L’application Mouzi n’envoie aucune télémétrie. Avec votre accord, ce site charge Google Analytics et transmet à Google la page, l’appareil et la zone approximative.','Détails de confidentialité','Autoriser l’analyse','Non merci'],it:['Cookie analitici opzionali','L’app Mouzi non invia telemetria. Con il consenso, il sito carica Google Analytics e invia a Google pagina, dispositivo e posizione approssimativa.','Dettagli privacy','Consenti analisi','No, grazie']}[locale];
---

<aside
  id="analytics-consent"
  class="fixed right-4 bottom-4 left-4 z-[120] mx-auto max-w-xl rounded-card border border-line bg-surface p-5 shadow-2xl sm:left-auto"
  role="dialog"
  aria-labelledby="analytics-consent-title"
  aria-describedby="analytics-consent-description"
  hidden
>
  <h2 id="analytics-consent-title" class="text-[15px] font-semibold text-cream">{a[0]}</h2>
  <p id="analytics-consent-description" class="mt-2 text-sm leading-relaxed text-muted">
    {a[1]} <a href={localizedPath('/privacy',locale)} class="text-amber hover:underline">{a[2]}</a>
  </p>
  <div class="mt-4 flex flex-wrap gap-3">
    <button
      id="analytics-accept"
      type="button"
      class="rounded-btn bg-amber px-4 py-2 text-sm font-semibold text-[#151004] hover:opacity-90"
    >
      {a[3]}
    </button>
    <button
      id="analytics-decline"
      type="button"
      class="rounded-btn border border-line px-4 py-2 text-sm text-cream hover:bg-surface-2"
    >
      {a[4]}
    </button>
  </div>
</aside>

<script is:inline define:vars={{ measurementId }}>
  (() => {
    const storageKey = 'mouzi-analytics-consent';
    const consentMaxAgeMs = 180 * 24 * 60 * 60 * 1000;
    const banner = document.getElementById('analytics-consent');
    const acceptButton = document.getElementById('analytics-accept');
    const declineButton = document.getElementById('analytics-decline');

    window.mouziAnalyticsEnabled = false;

    window.dataLayer = window.dataLayer || [];
    window.gtag = window.gtag || function () {
      window.dataLayer.push(arguments);
    };

    window.gtag('consent', 'default', {
      analytics_storage: 'denied',
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
    });

    const loadAnalytics = () => {
      window.mouziAnalyticsEnabled = true;
      if (document.querySelector('script[data-mouzi-analytics]')) return;

      window.gtag('consent', 'update', {
        analytics_storage: 'granted',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
      });
      window.gtag('js', new Date());
      window.gtag('config', measurementId);

      const script = document.createElement('script');
      script.async = true;
      script.src = `https://www.googletagmanager.com/gtag/js?id=${measurementId}`;
      script.dataset.mouziAnalytics = 'true';
      document.head.appendChild(script);
    };

    document.addEventListener('click', (event) => {
      if (!window.mouziAnalyticsEnabled) return;

      const link = event.target instanceof Element
        ? event.target.closest('[data-mouzi-download]')
        : null;
      if (!(link instanceof HTMLAnchorElement)) return;

      window.gtag('event', 'mouzi_download', {
        platform: link.dataset.downloadPlatform,
        artifact: link.dataset.downloadArtifact,
        file_name: link.dataset.downloadFile,
        app_version: link.dataset.downloadVersion,
        placement: window.location.pathname,
        link_url: link.href,
        transport_type: 'beacon',
      });
    });

    const clearAnalyticsCookies = () => {
      const domains = [location.hostname, `.${location.hostname}`, '.mouzi.cc'];
      document.cookie.split(';').forEach((cookie) => {
        const name = cookie.split('=')[0].trim();
        if (!name.startsWith('_ga')) return;
        document.cookie = `${name}=; Max-Age=0; path=/`;
        domains.forEach((domain) => {
          document.cookie = `${name}=; Max-Age=0; path=/; domain=${domain}`;
        });
      });
    };

    const showBanner = () => {
      if (banner) banner.hidden = false;
    };

    const hideBanner = () => {
      if (banner) banner.hidden = true;
    };

    const saveConsent = (value) => {
      localStorage.setItem(storageKey, JSON.stringify({ value, savedAt: Date.now() }));
    };

    const readConsent = () => {
      const raw = localStorage.getItem(storageKey);
      if (!raw) return null;

      try {
        const parsed = JSON.parse(raw);
        const validValue = parsed?.value === 'granted' || parsed?.value === 'denied';
        const stillCurrent = Number.isFinite(parsed?.savedAt) && Date.now() - parsed.savedAt <= consentMaxAgeMs;
        if (validValue && stillCurrent) return parsed.value;
      } catch {
        // Previous versions stored a plain string. Ask again under the current notice.
      }

      localStorage.removeItem(storageKey);
      return null;
    };

    const savedConsent = readConsent();
    if (savedConsent === 'granted') {
      loadAnalytics();
    } else if (savedConsent !== 'denied') {
      showBanner();
    }

    acceptButton?.addEventListener('click', () => {
      saveConsent('granted');
      loadAnalytics();
      hideBanner();
    });

    declineButton?.addEventListener('click', () => {
      saveConsent('denied');
      window.mouziAnalyticsEnabled = false;
      window.gtag('consent', 'update', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
      });
      clearAnalyticsCookies();
      hideBanner();
    });

    document.querySelectorAll('[data-manage-analytics]').forEach((button) => {
      button.addEventListener('click', () => {
        localStorage.removeItem(storageKey);
        showBanner();
      });
    });
  })();
</script>

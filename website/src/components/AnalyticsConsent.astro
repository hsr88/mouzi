---
import { localeFromPath, localizedPath } from '../i18n';
const measurementId = 'G-GMDTSE5DFS';
const locale=localeFromPath(Astro.url.pathname);
const a={"en":["Website analytics","The Mouzi app sends no telemetry. This website runs Google Analytics by default, sending page, device and approximate location data to Google. You can turn it off at any time.","Privacy details","Keep analytics on","Turn off analytics"],"pl":["Analityka strony","Aplikacja Mouzi nie wysyła telemetrii. Na stronie Google Analytics działa domyślnie i wysyła Google dane strony, urządzenia oraz przybliżonej lokalizacji. Możesz ją w każdej chwili wyłączyć.","Szczegóły prywatności","Pozostaw analitykę","Wyłącz analitykę"],"de":["Website-Analyse","Die Mouzi-App sendet keine Telemetrie. Diese Website nutzt standardmäßig Google Analytics und sendet Seiten-, Geräte- und ungefähre Standortdaten an Google. Du kannst die Analyse jederzeit ausschalten.","Datenschutzdetails","Analyse eingeschaltet lassen","Analyse ausschalten"],"es":["Análisis del sitio","La aplicación Mouzi no envía telemetría. Este sitio usa Google Analytics por defecto y envía a Google datos de página, dispositivo y ubicación aproximada. Puedes desactivarlo en cualquier momento.","Detalles de privacidad","Mantener el análisis","Desactivar análisis"],"fr":["Analyse du site","L’application Mouzi n’envoie aucune télémétrie. Ce site utilise Google Analytics par défaut et transmet à Google la page, l’appareil et la localisation approximative. Vous pouvez le désactiver à tout moment.","Détails de confidentialité","Garder l’analyse active","Désactiver l’analyse"],"it":["Analisi del sito","L’app Mouzi non invia telemetria. Questo sito usa Google Analytics per impostazione predefinita e invia a Google dati su pagina, dispositivo e posizione approssimativa. Puoi disattivarlo in qualsiasi momento.","Dettagli privacy","Mantieni attiva l’analisi","Disattiva analisi"]}[locale];
---

<aside
  id="analytics-consent"
  class="fixed right-4 bottom-4 left-4 z-[120] mx-auto max-w-xl rounded-card border border-line bg-surface p-5 shadow-2xl sm:left-auto"
  role="dialog"
  aria-labelledby="analytics-consent-title"
  aria-describedby="analytics-consent-description"
  hidden
>
  <h2 id="analytics-consent-title" class="text-[15px] font-semibold text-cream">{a[0]}</h2>
  <p id="analytics-consent-description" class="mt-2 text-sm leading-relaxed text-muted">
    {a[1]} <a href={localizedPath('/privacy',locale)} class="text-amber hover:underline">{a[2]}</a>
  </p>
  <div class="mt-4 flex flex-wrap gap-3">
    <button
      id="analytics-accept"
      type="button"
      class="rounded-btn bg-amber px-4 py-2 text-sm font-semibold text-[#151004] hover:opacity-90"
    >
      {a[3]}
    </button>
    <button
      id="analytics-decline"
      type="button"
      class="rounded-btn border border-line px-4 py-2 text-sm text-cream hover:bg-surface-2"
    >
      {a[4]}
    </button>
  </div>
</aside>

<script is:inline define:vars={{ measurementId }}>
  (() => {
    if (window.mouziAnalyticsInitialized) return;
    window.mouziAnalyticsInitialized = true;
    const storageKey = 'mouzi-analytics-consent';
    const banner = document.getElementById('analytics-consent');
    const acceptButton = document.getElementById('analytics-accept');
    const declineButton = document.getElementById('analytics-decline');

    window.mouziAnalyticsEnabled = false;

    window.dataLayer = window.dataLayer || [];
    window.gtag = window.gtag || function () {
      window.dataLayer.push(arguments);
    };

    window.gtag('consent', 'default', {
      analytics_storage: 'denied',
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
    });

    const loadAnalytics = () => {
      window['ga-disable-' + measurementId] = false;
      window.mouziAnalyticsEnabled = true;
      if (document.querySelector('script[data-mouzi-analytics]')) return;

      window.gtag('consent', 'update', {
        analytics_storage: 'granted',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
      });
      window.gtag('js', new Date());
      window.gtag('config', measurementId, { allow_google_signals: false, allow_ad_personalization_signals: false });

      const script = document.createElement('script');
      script.async = true;
      script.src = `https://www.googletagmanager.com/gtag/js?id=${measurementId}`;
      script.dataset.mouziAnalytics = 'true';
      document.head.appendChild(script);
    };

    document.addEventListener('click', (event) => {
      if (!window.mouziAnalyticsEnabled) return;

      const link = event.target instanceof Element
        ? event.target.closest('[data-mouzi-download]')
        : null;
      if (!(link instanceof HTMLAnchorElement)) return;

      window.gtag('event', 'mouzi_download', {
        platform: link.dataset.downloadPlatform,
        artifact: link.dataset.downloadArtifact,
        file_name: link.dataset.downloadFile,
        app_version: link.dataset.downloadVersion,
        placement: window.location.pathname,
        link_url: link.href,
        transport_type: 'beacon',
      });
    });

    const clearAnalyticsCookies = () => {
      const domains = [location.hostname, `.${location.hostname}`, '.mouzi.cc'];
      document.cookie.split(';').forEach((cookie) => {
        const name = cookie.split('=')[0].trim();
        if (!name.startsWith('_ga')) return;
        document.cookie = `${name}=; Max-Age=0; path=/`;
        domains.forEach((domain) => {
          document.cookie = `${name}=; Max-Age=0; path=/; domain=${domain}`;
        });
      });
    };

    const showBanner = () => {
      if (banner) banner.hidden = false;
    };

    const hideBanner = () => {
      if (banner) banner.hidden = true;
    };

    const saveConsent = (value) => {
      try { localStorage.setItem(storageKey, JSON.stringify({ value, savedAt: Date.now() })); } catch {}
    };

    const readConsent = () => {
      try {
        const raw = localStorage.getItem(storageKey);
        if (raw === 'denied' || raw === 'granted') return raw;
        const parsed = JSON.parse(raw);
        return ['denied', 'granted'].includes(parsed?.value) ? parsed.value : null;
      } catch { return null; }
    };

    const savedConsent = readConsent();
    if (savedConsent === 'denied') {
      window['ga-disable-' + measurementId] = true;
      clearAnalyticsCookies();
    } else {
      loadAnalytics();
      if (!savedConsent) showBanner();
    }

    acceptButton?.addEventListener('click', () => {
      saveConsent('granted');
      loadAnalytics();
      hideBanner();
    });

    declineButton?.addEventListener('click', () => {
      saveConsent('denied');
      window.mouziAnalyticsEnabled = false;
      window['ga-disable-' + measurementId] = true;
      window.gtag('consent', 'update', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
      });
      clearAnalyticsCookies();
      hideBanner();
      // Unload GA timers and listeners, including a script still in flight.
      location.reload();
    });

    window.addEventListener('storage', (event) => {
      if (event.key === storageKey && readConsent() === 'denied') {
        window.mouziAnalyticsEnabled = false;
        window['ga-disable-' + measurementId] = true;
        clearAnalyticsCookies();
        location.reload();
      }
    });

    document.querySelectorAll('[data-manage-analytics]').forEach((button) => {
      button.addEventListener('click', () => {
        showBanner();
      });
    });
  })();
</script>

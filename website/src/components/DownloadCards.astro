---
import { site, type DownloadArtifact } from '../config/site';
import { localeFromPath } from '../i18n';
import { downloadCopy } from '../i18n/download';
import { microsoftStoreCopy } from '../i18n/microsoft-store';

interface Props {
  platform: 'windows' | 'linux';
  compact?: boolean;
}
const { platform, compact = false } = Astro.props;
const artifacts: readonly DownloadArtifact[] = site.downloads[platform];
const locale = localeFromPath(Astro.url.pathname);
const text = downloadCopy(locale);
const storeText = microsoftStoreCopy[locale];
const storeBadgeLocale = locale === 'en' ? 'en-us' : locale;
---

{platform === 'windows' && (
  <div data-microsoft-store class="mb-4 rounded-card border border-amber/50 bg-surface p-5">
    <h3 class="text-lg font-semibold">Microsoft Store</h3>
    <p class="mt-2 text-sm leading-relaxed text-cream">{storeText.support}</p>
    <p class="mt-2 text-sm leading-relaxed text-muted">{storeText.certification}</p>
    <a href={site.microsoftStore} rel="noopener" class="mt-4 inline-block max-w-full rounded-btn transition-opacity hover:opacity-90">
      <img
        src={`https://get.microsoft.com/images/${storeBadgeLocale}%20dark.svg`}
        alt={storeText.button}
        width={locale === 'de' ? 183 : 161}
        height="44"
        class="h-14 w-auto max-w-full"
      />
    </a>
    <p class="mt-4 text-sm leading-relaxed">
      <a href={site.github.releases} class="text-amber underline underline-offset-4 hover:no-underline">{storeText.free}</a>
    </p>
  </div>
)}

<ul role="list" class="space-y-3">
  {
    artifacts.map((a) => (
      <li
        class:list={[
          'rounded-card border bg-surface p-4',
          a.recommended ? 'border-amber/50' : 'border-line',
        ]}
      >
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-2">
              <span class="text-[15px] font-semibold">{text.artifacts[a.label]?.label ?? a.label}</span>
              {a.recommended && (
                <span class="rounded border border-amber/50 px-1.5 py-0.5 font-mono text-[10px] tracking-[0.1em] text-amber uppercase">
                  {text.recommended}
                </span>
              )}
            </div>
            {!compact && a.note && <p class="mt-1 text-[13px] text-muted">{text.artifacts[a.label]?.note ?? a.note}</p>}
          </div>
          <a
            href={a.url}
            rel="noopener"
            data-mouzi-download
            data-download-platform={platform}
            data-download-artifact={a.label}
            data-download-file={a.file}
            data-download-version={site.version}
            class:list={[
              'ml-auto shrink-0 rounded-btn px-4 py-2 text-sm font-semibold transition-opacity hover:opacity-90',
              a.recommended ? 'bg-amber text-[#151004]' : 'border border-line text-cream hover:bg-surface-2',
            ]}
          >
            {text.download}
          </a>
        </div>
        <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 font-mono text-[11px] text-muted">
          <span class="[overflow-wrap:anywhere]">{a.file}</span>
          <span>{a.arch}</span>
          <span>v{site.version}</span>
          <span>{a.size ?? '—'}</span>
        </div>
        {!compact && a.sha256 && (
          <div class="mt-2 break-all font-mono text-[11px] text-muted">
            SHA-256: {a.sha256}
          </div>
        )}
      </li>
    ))
  }
</ul>
